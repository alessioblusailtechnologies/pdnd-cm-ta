# LLM provider key (Anthropic via Mastra)
ANTHROPIC_API_KEY=

# Supabase (persistenza chat)
# SUPABASE_URL: URL del progetto (https://<ref>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: chiave service_role — usata SOLO server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tavily API key for the web search tool
# Get one at https://tavily.com
TAVILY_API_KEY=

# Resend API key for email sending (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=PDMD-TA <onboarding@resend.dev>

# Tributi API (Civilia Next) — switch tra mock e API reale
# mock: usa dati canned (default in sviluppo, nessuna credenziale richiesta)
# real: chiama la API reale via PDND (richiede BASE_URL e TOKEN)
TRIBUTI_API_MODE=mock
TRIBUTI_API_BASE_URL=https://tributipdnd.civilianext.it
TRIBUTI_API_TOKEN=

# Indicatori API (BoxxApps) — switch tra mock e API reale
# mock: usa valori canned plausibili per il Comune di Taranto
# real: chiama la API reale via PDND (richiede BASE_URL e TOKEN)
INDICATORI_API_MODE=mock
INDICATORI_API_BASE_URL=
INDICATORI_API_TOKEN=
